# ==============================================================
# Face Identification & Blockchain Verification — Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# ── Search provider ─────────────────────────────────────────
# SerpAPI (https://serpapi.com) — Google Lens reverse-image search
# Free tier: 100 searches/month.  Recommended.
SERPAPI_KEY=

# Bing Visual Search (optional fallback / native file-upload)
# https://www.microsoft.com/en-us/bing/apis/bing-visual-search-api
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

# ── Blockchain ───────────────────────────────────────────────
# Ethereum Sepolia testnet via Infura / Alchemy / public RPC
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org

# Wallet funded with Sepolia test-ETH (https://sepoliafaucet.com)
# Leave blank to run in labelled SIMULATION mode (no real tx).
BLOCKCHAIN_PRIVATE_KEY=

# Address of the deployed FingerprintRegistry contract
# (see contracts/FingerprintRegistry.sol and README for Remix deploy)
# Leave blank to run in labelled SIMULATION mode.
BLOCKCHAIN_CONTRACT_ADDRESS=

# Human-readable network label shown in output
BLOCKCHAIN_NETWORK=Ethereum Sepolia Testnet

# Chain ID — 11155111 for Sepolia
BLOCKCHAIN_CHAIN_ID=11155111

# ── Face matching ────────────────────────────────────────────
# Cosine-similarity threshold (0–1).  Values ≥ threshold → MATCH.
# Official OpenCV SFace recommended value is 0.363.
# Increase to reduce false positives; decrease to reduce false negatives.
# THIS THRESHOLD IS EXPERIMENTAL and may produce false positives/negatives.
FACE_MATCH_THRESHOLD=0.363

# ── Application ──────────────────────────────────────────────
LOG_LEVEL=INFO

# Project identifier stored as metadata with every on-chain record
PROJECT_ID=HH-GOA-2026-TASK3
